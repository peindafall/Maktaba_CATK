# Production Environment Variables
# COPY TO .env.prod AND FILL IN VALUES

# Django
SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_KEY_50_CHARS_MIN
DEBUG=False
ALLOWED_HOSTS=catk.org,www.catk.org

# Database
DB_NAME=maktaba_catk
DB_USER=maktaba_user
DB_PASSWORD=STRONG_DB_PASSWORD_HERE
DATABASE_URL=postgres://maktaba_user:STRONG_DB_PASSWORD_HERE@db:5432/maktaba_catk

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# MinIO
MINIO_ACCESS_KEY=MINIO_ACCESS_KEY_HERE
MINIO_SECRET_KEY=MINIO_SECRET_KEY_HERE
MINIO_BUCKET_NAME=maktabacatk
MINIO_ENDPOINT=http://minio:9000

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@catk.org
EMAIL_HOST_PASSWORD=APP_PASSWORD_HERE
DEFAULT_FROM_EMAIL=Maktaba CATK <contact@catk.org>

# CORS
CORS_ALLOWED_ORIGINS=https://catk.org,https://www.catk.org
